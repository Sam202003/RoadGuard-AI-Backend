NODE_ENV=development
PORT=3000
APP_NAME=roadguard-api
LOG_LEVEL=debug
API_PREFIX=/api
API_VERSION=v1
CORS_ORIGIN=*
TRUST_PROXY=false

MONGODB_URI=mongodb://localhost:27017/roadguard
MONGODB_DB_NAME=roadguard
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=3000

REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=10
REDIS_ENABLED=true

JWT_ACCESS_SECRET=dev-access-secret-min-16-chars
JWT_REFRESH_SECRET=dev-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
MAX_REFRESH_SESSIONS=5

SOCKET_ENABLED=true
SOCKET_PATH=/socket.io
SOCKET_REDIS_ADAPTER=false
SOCKET_MAX_EVENTS_PER_WINDOW=50
SOCKET_RATE_LIMIT_WINDOW_MS=10000
SOCKET_HEARTBEAT_TIMEOUT_MS=90000

# OpenAI (optional — fallback rules used when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AES-256-GCM key for encrypting provider bank details at rest (base64, 32 bytes)
# Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
